{
  "name": "cvgen-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @cvgen/backend --filter @cvgen/frontend dev",
    "dev:backend": "pnpm --filter @cvgen/backend dev",
    "dev:frontend": "pnpm --filter @cvgen/frontend dev",
    "build:backend": "pnpm --filter @cvgen/backend build",
    "build:frontend": "pnpm --filter @cvgen/frontend build",
    "deploy:backend": "pnpm --filter @cvgen/backend deploy",
    "deploy:frontend": "pnpm --filter @cvgen/frontend deploy",
    "lint": "pnpm --filter @cvgen/frontend lint",
    "format": "pnpm --filter @cvgen/frontend format",
    "check": "pnpm --filter @cvgen/frontend check",
    "test": "pnpm --filter @cvgen/frontend test"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
